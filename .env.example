# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/connect_admin

# Admin authentication (change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=change-me-to-random-string
TOKEN_SECRET=change-me-to-random-string

# Branding
ADMIN_APP_NAME=Connect Admin
ADMIN_APP_TAGLINE=Headless CMS & Admin Panel
ADMIN_WEBSITE_URL=https://your-website.com

# CORS — origins allowed to call public API (comma-separated, or * for all)
ADMIN_CORS_ORIGINS=http://localhost:3000,https://your-website.com

# Module toggles (true/false) and custom labels
ADMIN_MODULE_CATALOG=true
ADMIN_MODULE_CATALOG_LABEL=Catalog
ADMIN_MODULE_BLOG=true
ADMIN_MODULE_BLOG_LABEL=Blog
ADMIN_MODULE_INQUIRIES=true
ADMIN_MODULE_INQUIRIES_LABEL=Inquiries
ADMIN_MODULE_TEAM=true
ADMIN_MODULE_TEAM_LABEL=Team
ADMIN_MODULE_NEWSLETTER=true
ADMIN_MODULE_NEWSLETTER_LABEL=Subscribers

PORT=5000
