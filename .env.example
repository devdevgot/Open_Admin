# Database (required for standalone mode)
DATABASE_URL=postgresql://user:password@localhost:5432/open_admin

# Server
PORT=5000
SESSION_SECRET=change-me-in-production
TOKEN_SECRET=change-me-in-production

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Optional: allow admin UI hosted on another origin
CORS_ORIGIN=http://localhost:5173

# Client branding (Vite — set at build time)
VITE_APP_NAME=Open Admin
VITE_APP_TAGLINE=Content Management
# VITE_WEBSITE_URL=https://your-website.com
# VITE_API_BASE_URL=https://api.your-project.com
